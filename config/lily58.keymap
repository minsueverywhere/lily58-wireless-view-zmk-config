#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 2400  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30    // default: 10

&mmv {
    time-to-max-speed-ms = <200>;
    acceleration-exponent = <1>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <50>;
    retro-tap;
};

/ {
    combos {
        compatible = "zmk,combos";

        LShiftCombo {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        LControlCombo {
            bindings = <&kp LCTRL>;
            key-positions = <>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        LAltCombo {
            bindings = <&kp LEFT_ALT>;
            key-positions = <>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        LCtrlLShiftCombo {
            bindings = <&kp LC(LEFT_SHIFT)>;
            key-positions = <>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        LCtrlLAltCombo {
            bindings = <&kp LC(LEFT_ALT)>;
            key-positions = <>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        LCtrlLShiftLAltCombo {
            bindings = <&kp LC(LA(LEFT_SHIFT))>;
            key-positions = <>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        RShiftCombo {
            bindings = <&kp RSHIFT>;
            key-positions = <>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        RCtrlCombo {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        RLAltCombo {
            bindings = <&kp LEFT_ALT>;
            key-positions = <>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        RCtrlRShiftCombo {
            bindings = <&kp LC(RIGHT_SHIFT)>;
            key-positions = <>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        RCtrlRAltCombo {
            bindings = <&kp LC(LEFT_ALT)>;
            key-positions = <>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        RCtrlRShiftRAltCombo {
            bindings = <&kp LC(LA(RIGHT_SHIFT))>;
            key-positions = <>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        LGuiCombo {
            bindings = <&kp LEFT_GUI>;
            key-positions = <>;
            slow-release;
            require-prior-idle-ms = <200>;
            timeout-ms = <100>;
        };

        RGuiCombo {
            bindings = <&kp RIGHT_GUI>;
            key-positions = <>;
            slow-release;
            require-prior-idle-ms = <200>;
            timeout-ms = <100>;
        };

        LShiftLAltCombo {
            bindings = <&kp LA(LEFT_SHIFT)>;
            key-positions = <>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        RShiftLAltCombo {
            bindings = <&kp LA(RIGHT_SHIFT)>;
            key-positions = <>;
            slow-release;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        LShiftLGuiCombo {
            bindings = <&kp LS(LEFT_GUI)>;
            key-positions = <>;
            require-prior-idle-ms = <50>;
            slow-release;
            timeout-ms = <100>;
        };

        LCtrlLGuiCombo {
            bindings = <&kp LC(LEFT_GUI)>;
            key-positions = <>;
            require-prior-idle-ms = <50>;
            slow-release;
            timeout-ms = <100>;
        };

        LAltLGuiCombo {
            bindings = <&kp LA(LEFT_GUI)>;
            key-positions = <>;
            require-prior-idle-ms = <50>;
            slow-release;
            timeout-ms = <100>;
        };

        RShiftRGuiCombo {
            bindings = <&kp LS(RIGHT_GUI)>;
            key-positions = <>;
            slow-release;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        LCtrlRGuiCombo {
            bindings = <&kp LC(RIGHT_GUI)>;
            key-positions = <>;
            slow-release;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        LAltRGuiCombo {
            bindings = <&kp LA(RIGHT_GUI)>;
            key-positions = <>;
            slow-release;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        M3Combo {
            bindings = <&mkp MB3>;
            key-positions = <5 6>;
            timeout-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Base";
            bindings = <
&kp ESCAPE        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp MB2                     &mkp MB1     &kp LEFT         &kp DOWN             &kp UP   &kp RIGHT  &kp DELETE
&kp TAB           &kp Q           &kp W           &kp E         &kp R            &kp T                        &kp Y        &kp U            &kp I                &kp O    &kp P      &kp BACKSPACE
&kp LEFT_SHIFT    &kp A           &kp S           &kp D         &kp F            &kp G                        &kp H        &kp J            &kp K                &kp L    &kp SEMI   &kp RIGHT_SHIFT
&kp LEFT_CONTROL  &kp Z           &kp X           &kp C         &kp V            &kp B        &none    &none  &kp N        &kp M            &kp COMMA            &kp DOT  &kp FSLH   &kp SQT
                                                  &kp LEFT_ALT  &lt 2 LEFT_GUI   &lt 1 SPACE  &none    &none  &lt 1 ENTER  &lt 2 RIGHT_ALT  &lt 3 RIGHT_CONTROL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        special_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Special";
            bindings = <
&mkp MB4   &msc SCRL_LEFT   &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &mkp MB5                       &kp LS(LC(TAB))  &kp HOME        &kp PG_UP        &kp PG_DN             &kp END                &kp LC(TAB)
&trans     &kp MINUS        &kp UNDERSCORE  &kp EQUAL     &kp PLUS         &trans                         &trans           &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN     &kp HASH      &kp DOLLAR       &kp PERCENT                    &kp CARET        &kp AMPERSAND   &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&kp GRAVE  &kp N1           &kp N2          &kp N3        &kp N4           &kp N5       &trans    &trans  &kp N6           &kp N7          &kp N8           &kp N9                &kp N0                 &kp BACKSLASH
                                            &trans        &trans           &trans       &trans    &trans  &trans           &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fn_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "FN";
            bindings = <
&trans         &trans  &trans   &trans                   &trans   &trans                                   &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_NXT     &kp F1  &kp F2   &kp F3                   &kp F4   &trans                                   &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_PRV     &kp F5  &kp F6   &kp F7                   &kp F8   &trans                                   &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_DISC 2  &kp F9  &kp F10  &kp F11                  &kp F12  &trans                 &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                &mt C_MUTE C_PLAY_PAUSE  &trans   &mt C_PREVIOUS C_NEXT  &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        mod_layer {
            display-name = "Mod";
            bindings = <
&trans  &trans           &trans         &trans           &trans           &trans                             &trans           &trans           &trans           &trans           &trans         &trans
&trans  &kp KP_NUMLOCK   &kp CAPSLOCK   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9                    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMLOCK   &kp CAPSLOCK   &trans
&trans  &kp KP_PLUS      &kp KP_MINUS   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6                    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS      &kp KP_MINUS   &trans
&trans  &kp KP_MULTIPLY  &kp KP_DIVIDE  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans    &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MULTIPLY  &kp KP_DIVIDE  &trans
                                        &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_ENTER     &trans    &trans  &kp KP_DOT       &kp KP_NUMBER_0  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
