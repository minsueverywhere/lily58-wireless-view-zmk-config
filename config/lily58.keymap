#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        LShiftCombo {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <25 26>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <30>;
        };

        LControlCombo {
            bindings = <&kp LCTRL>;
            key-positions = <26 27>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <30>;
        };

        LAltCombo {
            bindings = <&kp LEFT_ALT>;
            key-positions = <27 28>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <30>;
        };

        LCtrlLShiftCombo {
            bindings = <&kp LC(LEFT_SHIFT)>;
            key-positions = <25 26 27>;
            slow-release;
            require-prior-idle-ms = <50>;
        };

        LCtrlLAltCombo {
            bindings = <&kp LC(LEFT_ALT)>;
            key-positions = <26 27 28>;
            slow-release;
            require-prior-idle-ms = <50>;
        };

        LCtrlLShiftLAltCombo {
            bindings = <&kp LC(LA(LEFT_SHIFT))>;
            key-positions = <25 26 27 28>;
            slow-release;
            require-prior-idle-ms = <50>;
        };

        RShiftCombo {
            bindings = <&kp RSHIFT>;
            key-positions = <34 33>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <30>;
        };

        RCtrlCombo {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <33 32>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <30>;
        };

        RAltCombo {
            bindings = <&kp LEFT_ALT>;
            key-positions = <31 32>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <30>;
        };

        RCtrlRShiftCombo {
            bindings = <&kp LC(RIGHT_SHIFT)>;
            key-positions = <34 33 32>;
            slow-release;
            require-prior-idle-ms = <50>;
        };

        RCtrlRAltCombo {
            bindings = <&kp LC(LEFT_ALT)>;
            key-positions = <32 31 33>;
            slow-release;
            require-prior-idle-ms = <50>;
        };

        RCtrlRShiftRAltCombo {
            bindings = <&kp LC(LA(RIGHT_SHIFT))>;
            key-positions = <31 32 33 34>;
            slow-release;
            require-prior-idle-ms = <50>;
        };

        LGuiCombo {
            bindings = <&kp LEFT_GUI>;
            key-positions = <28 29>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <30>;
        };

        RGuiCombo {
            bindings = <&kp RIGHT_GUI>;
            key-positions = <31 30>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <30>;
        };
    };

    behaviors {
        esc_tilde: esc_tilde {
            compatible = "zmk,behavior-mod-morph";
            label = "ESC_TILDE";
            bindings = <&kp ESCAPE>, <&kp TILDE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&esc_tilde          &kp N1  &kp N2  &kp N3        &kp N4          &kp N5                       &kp N6       &kp N7           &kp N8         &kp N9   &kp N0    &kp DELETE
&kp TAB             &kp Q   &kp W   &kp E         &kp R           &kp T                        &kp Y        &kp U            &kp I          &kp O    &kp P     &kp BACKSPACE
&mt LCTRL CAPSLOCK  &kp A   &kp S   &kp D         &kp F           &kp G                        &kp H        &kp J            &kp K          &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT      &kp Z   &kp X   &kp C         &kp V           &kp B        &none    &none  &kp N        &kp M            &kp COMMA      &kp DOT  &kp FSLH  &kp RSHFT
                                    &kp LEFT_ALT  &lt 2 LEFT_GUI  &lt 1 SPACE  &none    &none  &lt 3 ENTER  &lt 4 BACKSPACE  &kp RIGHT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        left_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Left";
            bindings = <
&kp N6  &kp N7  &kp N8     &kp N9      &kp N0         &kp DELETE                         &kp F1  &kp F2          &kp F3            &kp F4        &kp F5           &kp F6
&kp Y   &kp U   &kp I      &kp O       &kp P          &kp BACKSPACE                      &kp F7  &kp F8          &kp F9            &kp F10       &kp F11          &kp F12
&kp H   &kp J   &kp K      &kp L       &kp SEMICOLON  &kp SQT                            &trans  &kp LEFT_ARROW  &kp DOWN_ARROW    &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&kp N   &kp M   &kp COMMA  &kp PERIOD  &kp SLASH      &kp RIGHT_SHIFT  &trans    &trans  &trans  &kp HOME        &kp PAGE_DOWN     &kp PAGE_UP   &kp END          &trans
                           &kp ENTER   &kp RIGHT_ALT  &trans           &trans    &trans  &trans  &kp C_MUTE      &kp C_PLAY_PAUSE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        left_alt_layer {
            display-name = "LAlt";
            bindings = <
&bt BT_CLR            &bt BT_SEL 0           &bt BT_SEL 1   &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                       &trans  &trans  &trans  &trans  &trans  &trans
&kp MINUS             &kp EQUAL              &kp GRAVE      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9                    &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp BACKSLASH  &kt KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6                    &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp KP_ENTER   &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                            &kp KP_NUMBER_0  &trans           &kp KP_DOT       &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        right_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Right";
            bindings = <
&kp F1  &kp F2          &kp F3          &kp F4            &kp F5           &kp F6                     &kp ESCAPE          &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5
&kp F7  &kp F8          &kp F9          &kp F10           &kp F11          &kp F12                    &kp TAB             &kp Q         &kp W         &kp E         &kp R         &kp T
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW      &kp RIGHT_ARROW  &trans                     &mt LCTRL CAPSLOCK  &kp A         &kp S         &kp D         &kp F         &kp G
&trans  &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP       &kp END          &trans   &trans    &trans  &kp LSHIFT          &kp Z         &kp X         &kp C         &kp V         &kp B
                                        &kp C_PLAY_PAUSE  &kp C_MUTE       &trans   &trans    &trans  &trans              &kp LEFT_GUI  &kp SPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        right_alt_layer {
            display-name = "RightAlt";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &kp KP_PLUS      &kp KP_MINUS     &kp KP_ASTERISK  &kp KP_DIVIDE         &kp KP_EQUAL           &kp KP_NUMLOCK
&trans  &trans  &trans  &trans  &trans  &trans                    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS             &kp EQUAL              &kp GRAVE
&trans  &trans  &trans  &trans  &trans  &trans                    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp BACKSLASH
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp KP_ENTER
                        &trans  &trans  &trans  &trans    &trans  &kp KP_NUMBER_0  &trans           &kp KP_DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
