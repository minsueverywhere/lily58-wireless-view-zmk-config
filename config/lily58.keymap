#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 2400  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30    // default: 10

&mmv {
    time-to-max-speed-ms = <200>;
    acceleration-exponent = <1>;
};

&lt { flavor = "balanced"; };

/ {
    combos {
        compatible = "zmk,combos";

        M3Combo {
            bindings = <&mkp MB3>;
            key-positions = <5 6>;
            timeout-ms = <100>;
        };

        cb_sion {
            bindings = <&mcr_sion>;
            key-positions = <21 20 26>;
        };

        cb_tion {
            bindings = <&mcr_tion>;
            key-positions = <17 20 21>;
        };

        cb_ment {
            bindings = <&mcr_ment>;
            key-positions = <45 15 17>;
        };

        cb_ness {
            bindings = <&mcr_ness>;
            key-positions = <44 15 26>;
        };

        cb_less {
            bindings = <&mcr_less>;
            key-positions = <26 15 33 33>;
        };

        cb_able {
            bindings = <&mcr_able>;
            key-positions = <25 41 33>;
        };

        cb_over {
            bindings = <&mcr_over>;
            key-positions = <21 40 15>;
        };

        cb_tive {
            bindings = <&mcr_tive>;
            key-positions = <20 17 40>;
        };

        cb_lity {
            bindings = <&mcr_lity>;
            key-positions = <17 33 20>;
        };
    };

    macros {
        mcr_sion: mcr_sion {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp I &kp O &kp N>;
            label = "MCR_SION";
        };

        mcr_tion: mcr_tion {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp I &kp O &kp N>;
            label = "MCR_TION";
        };

        mcr_ment: mcr_ment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp E &kp N &kp T>;
            label = "MCR_MENT";
        };

        mcr_ness: mcr_ness {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &kp E &kp S &kp S>;
            label = "MCR_NESS";
        };

        mcr_less: mcr_less {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp E &kp S &kp S>;
            label = "MCR_LESS";
        };

        mcr_able: mcr_able {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp B &kp L &kp E>;
            label = "MCR_ABLE";
        };

        mcr_over: mcr_over {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp O &kp V &kp E &kp R>;
            label = "MCR_OVER";
        };

        mcr_tive: mcr_tive {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp I &kp V &kp E>;
            label = "MCR_TIVE";
        };

        mcr_lity: mcr_lity {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp I &kp T &kp Y>;
            label = "MCR_LITY";
        };

        mcr_anti: mcr_anti {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp N &kp T &kp I>;
            label = "MCR_ANTI";
        };

        mcr_self: mcr_self {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp E &kp L &kp F>;
            label = "MCR_SELF";
        };

        mcr_ward: mcr_ward {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp A &kp R &kp D>;
            label = "MCR_WARD";
        };

        mcr_super: mcr_super {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp U &kp P &kp E &kp R>;
            label = "MCR_SUPER";
        };

        mcr_inter: mcr_inter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I &kp N &kp T &kp E &kp R>;
            label = "MCR_INTER";
        };

        mcr_under: mcr_under {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp U &kp N &kp D &kp E &kp R>;
            label = "MCR_UNDER";
        };

        mcr_extra: mcr_extra {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E &kp X &kp T &kp R &kp A>;
            label = "MCR_EXTRA";
        };

        new_func: new_func {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F &kp U &kp N &kp C>;
            label = "NEW_FUNC";
        };

        mcr_enum: mcr_enum {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E &kp N &kp U &kp M>;
            label = "MCR_ENUM";
        };

        mcr_const: mcr_const {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp O &kp N &kp S &kp T>;
            label = "MCR_CONST";
        };

        mcr_class: mcr_class {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp L &kp A &kp S &kp S>;
            label = "MCR_CLASS";
        };

        mcr_static: mcr_static {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp T &kp A &kp T &kp I &kp C>;
            label = "MCR_STATIC";
            tap-ms = <500>;
        };

        mcr_export: mcr_export {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E &kp X &kp P &kp O &kp R &kp T>;
            label = "MCR_EXPORT";
            wait-ms = <10>;
        };

        mcr_extend: mcr_extend {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E &kp X &kp T &kp E &kp N &kp D>;
            label = "MCR_EXTEND";
            wait-ms = <100>;
        };

        mcr_position: mcr_position {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp P &kp O &kp S &kp I &kp T &kp I &kp O &kp N>;
            label = "MCR_POSITION";
        };

        mcr_queue: mcr_queue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp U &kp E &kp U &kp E>;
            label = "MCR_QUEUE";
        };

        mcr_yield: mcr_yield {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp I &kp E &kp L &kp D>;
            label = "MCR_YIELD";
        };

        mcr_should: mcr_should {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp H &kp O &kp U &kp L &kp D>;
            label = "MCR_SHOULD";
        };

        mcr_would: mcr_would {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp O &kp U &kp L &kp D>;
            label = "MCR_WOULD";
        };

        mcr_could: mcr_could {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp O &kp U &kp L &kp D>;
            label = "MCR_COULD";
        };

        mcr_delta: mcr_delta {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp E &kp L &kp T &kp A>;
            label = "MCR_DELTA";
        };

        mcr_vector: mcr_vector {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp V &kp E &kp C &kp T &kp O &kp R>;
            label = "MCR_VECTOR";
        };

        mcr_button: mcr_button {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp U &kp T &kp T &kp O &kp N>;
            label = "MCR_BUTTON";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Base";
            bindings = <
&kp ESCAPE        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp MB2                     &mkp MB1     &kp LEFT         &kp DOWN           &kp UP   &kp RIGHT  &kp DELETE
&kp TAB           &kp Q           &kp W           &kp E         &kp R            &kp T                        &kp Y        &kp U            &kp I              &kp O    &kp P      &kp BACKSPACE
&kp LEFT_SHIFT    &kp A           &kp S           &kp D         &kp F            &kp G                        &kp H        &kp J            &kp K              &kp L    &kp SEMI   &kp RIGHT_SHIFT
&kp LEFT_CONTROL  &kp Z           &kp X           &kp C         &kp V            &kp B        &none    &none  &kp N        &kp M            &kp COMMA          &kp DOT  &kp FSLH   &kp SQT
                                                  &kp LEFT_ALT  &kp LEFT_GUI     &lt 1 SPACE  &none    &none  &lt 1 ENTER  &lt 2 RIGHT_ALT  &kp RIGHT_CONTROL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        special_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Special";
            bindings = <
&mkp MB4  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &mkp MB5                    &kp LS(LC(TAB))  &kp HOME  &kp PG_UP  &kp PG_DN  &kp END  &kp LC(TAB)
&kp F1    &kp F2          &kp F3          &kp F4        &kp F5           &kp F6                      &kp F7           &kp F8    &kp F9     &kp F10    &kp F11  &kp F12
&trans    &kp N1          &kp N2          &kp N3        &kp N4           &kp N5                      &kp N6           &kp N7    &kp N8     &kp N9     &kp N0   &trans
&trans    &trans          &kp GRAVE       &kp MINUS     &kp EQUAL        &trans    &trans    &trans  &trans           &kp LBKT  &kp RBKT   &kp BSLH   &trans   &trans
                                          &trans        &trans           &trans    &trans    &trans  &trans           &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        numpad_layer {
            display-name = "Numpad";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &bt BT_DISC 2    &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3   &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans                    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMLOCK   &kp CAPSLOCK   &mt C_PREVIOUS C_VOLUME_UP
&trans  &trans  &trans  &trans  &trans  &trans                    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS      &kp KP_MINUS   &mt C_NEXT C_VOLUME_DOWN
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MULTIPLY  &kp KP_DIVIDE  &mt C_PLAY_PAUSE C_MUTE
                        &trans  &trans  &trans  &trans    &trans  &kp KP_NUMBER_0  &trans           &kp KP_DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
