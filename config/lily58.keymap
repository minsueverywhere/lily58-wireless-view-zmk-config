#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        LShift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <25 26>;
        };

        LControl {
            bindings = <&kp LCTRL>;
            key-positions = <26 27>;
        };

        LAlt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <27 28>;
        };

        LCtrl+LShift {
            bindings = <&kp LC(LEFT_SHIFT)>;
            key-positions = <25 26 27>;
        };

        LCtrl+LAlt {
            bindings = <&kp LC(LEFT_ALT)>;
            key-positions = <26 27 28>;
        };

        LCtrl+LShift+LAlt {
            bindings = <&kp LC(LA(LEFT_SHIFT))>;
            key-positions = <25 26 27 28>;
        };

        RShift {
            bindings = <&kp RSHIFT>;
            key-positions = <34 33>;
        };

        R-LCtrl {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <33 32>;
        };

        R-LAlt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <31 32>;
        };

        R-LCtrl+RShift {
            bindings = <&kp LC(RIGHT_SHIFT)>;
            key-positions = <34 33 32>;
        };

        R-LCtrl+R-LAlt {
            bindings = <&kp LC(LEFT_ALT)>;
            key-positions = <32 31 33>;
        };

        R-LCtrl+RShift+R-LAlt {
            bindings = <&kp LC(LA(RIGHT_SHIFT))>;
            key-positions = <31 32 33 34>;
        };

        LGui {
            bindings = <&kp LEFT_GUI>;
            key-positions = <28 29>;
        };

        RGui {
            bindings = <&kp RIGHT_GUI>;
            key-positions = <31 30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3        &kp N4          &kp N5                       &kp N6       &kp N7           &kp N8           &kp N9   &kp N0    &kp DELETE
&kp TAB         &kp Q   &kp W   &kp E         &kp R           &kp T                        &kp Y        &kp U            &kp I            &kp O    &kp P     &kp BACKSLASH
&kp LCTRL       &kp A   &kp S   &kp D         &kp F           &kp G                        &kp H        &kp J            &kp K            &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z   &kp X   &kp C         &kp V           &kp B        &none    &none  &kp N        &kp M            &kp COMMA        &kp DOT  &kp FSLH  &kp RSHFT
                                &kp LEFT_ALT  &lt 3 LEFT_GUI  &lt 1 SPACE  &none    &none  &lt 2 ENTER  &lt 4 BACKSPACE  &lt 4 RIGHT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        left_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Left";
            bindings = <
&kp N6  &kp N7  &kp N8  &kp N9     &kp N0           &kp BACKSPACE                           &kp CAPSLOCK  &kp KP_NUMLOCK   &kp SLASH        &kp ASTERISK     &kp MINUS     &kp K_PLAY_PAUSE
&kp Y   &kp U   &kp I   &kp O      &kp P            &kp NON_US_BACKSLASH                    &kp INSERT    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS      &kp K_MUTE
&kp H   &kp J   &kp K   &kp L      &kp SEMICOLON    &kp SQT                                 &kp HOME      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_ENTER  &trans
&kp N   &kp N   &kp M   &kp COMMA  &kp PERIOD       &kp SLASH             &trans    &trans  &kp END       &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans        &trans
                        &kp ENTER  &kp RIGHT_SHIFT  &trans                &trans    &trans  &trans        &kp KP_NUMBER_0  &kp PERIOD
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        right_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Right";
            bindings = <
&kp TILDE  &trans  &trans  &trans   &trans   &trans                     &trans         &trans    &trans    &trans  &trans     &kp DELETE
&kp GRAVE  &kp N1  &kp N2  &kp N3   &kp N4   &kp N5                     &kp N6         &kp N7    &kp N8    &kp N9  &kp N0     &trans
&kp F1     &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                     &kp PAGE_UP    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
&kp F7     &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &kp PAGE_DOWN  &trans    &trans    &trans  &trans     &trans
                           &trans   &trans   &trans   &trans    &trans  &trans         &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        left_alt_layer {
            display-name = "LAlt";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB     &trans        &trans        &trans        &kp LA(F4)    &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        right_alt_layer {
            display-name = "RAlt";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans             &trans          &trans        &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &msc SCRL_LEFT     &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &mmv MOVE_LEFT     &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &mkp LCLK          &mkp MCLK       &mkp RCLK     &mkp MB4         &mkp MB5
                        &trans  &trans  &trans  &trans    &trans  &trans  &kp RIGHT_CONTROL  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
