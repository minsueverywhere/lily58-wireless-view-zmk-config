#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 4096  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 32    // default: 10

&mmv { time-to-max-speed-ms = <500>; };

&lt {
    flavor = "tap-preferred";
    retro-tap;
};

/ {
    combos {
        compatible = "zmk,combos";

        cb_keypad_left {
            bindings = <&mo 5>;
            key-positions = <52 50>;
            slow-release;
        };

        cb_keypad_right {
            bindings = <&mo 5>;
            key-positions = <55 57>;
            slow-release;
        };

        cb_mo2_left {
            bindings = <&mo 2>;
            key-positions = <>;
            slow-release;
        };

        cb_mo2_right {
            bindings = <&mo 2>;
            key-positions = <>;
            slow-release;
        };

        cb_m3 {
            bindings = <&mkp MB3>;
            key-positions = <51 52>;
        };
    };

    behaviors {
        sticky_shift: sticky_shift {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_SHIFT";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <300>;
            quick-release;
        };

        shift_hold_tap: shift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "SHIFT_HOLD_TAP";
            bindings = <&kp>, <&sticky_shift>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
        };

        my_shift: my_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "MY_SHIFT";
            #binding-cells = <0>;
            bindings = <&shift_hold_tap LEFT_SHIFT LEFT_SHIFT>, <&caps_word>;

            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Base";
            bindings = <
&kp TAB    &kp Q     &kp W      &kp E          &kp R      &kp T                        &kp Y             &kp U              &kp I      &kp O     &kp P     &kp BSPC
&kp LSHFT  &kp A     &kp S      &kp D          &kp F      &kp G                        &kp H             &kp J              &kp K      &kp L     &kp SEMI  &kp RSHFT
&kp LCTRL  &kp Z     &kp X      &kp C          &kp V      &kp B                        &kp N             &kp M              &kp COMMA  &kp DOT   &kp UP    &kp RIGHT_ALT
&kp LALT   &kp LGUI  &kp GRAVE  &kp BACKSLASH  &kp MINUS  &kp PLUS     &none    &none  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SLASH  &kp LEFT  &kp DOWN  &kp RIGHT
                                &mo 2          &mo 3      &lt 1 SPACE  &none    &none  &lt 1 ENTER       &mo 3              &mo 2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        special_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Special";
            bindings = <
&kp ESC  &kp CARET  &kp AMPERSAND  &kp ASTERISK    &trans          &trans                       &trans                &trans                 &kp SQT       &kp DQT   &kp PERCENT  &kp DELETE
&trans   &kp N6     &kp N7         &kp N8          &kp N9          &kp N0                       &kp EXCL              &kp AT                 &kp POUND     &kp DLLR  &kp COLON    &kp INSERT
&trans   &kp N1     &kp N2         &kp N3          &kp N4          &kp N5                       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LT        &kp GT    &kp PG_UP    &kp RCTRL
&trans   &trans     &kp TILDE      &kp PIPE        &kp UNDERSCORE  &kp EQUAL  &trans    &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp QUESTION  &kp HOME  &kp PG_DN    &kp END
                                   &kp LEFT_ARROW  &kp RIGHT       &none      &trans    &trans  &none                 &trans                 &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        function_layer {
            display-name = "Function";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans                                        &bt BT_DISC 0     &bt BT_DISC 1  &bt BT_DISC 2   &bt BT_DISC 3   &bt BT_DISC 4   &bt BT_CLR
&trans        &kp F9        &kp F10       &kp F11       &kp F12       &mt C_PREVIOUS C_VOLUME_UP                    &kp C_PREVIOUS    &kp F21        &kp F22         &kp F23         &kp F24         &trans
&trans        &kp F5        &kp F6        &kp F7        &kp F8        &mt C_PP C_MUTE                               &kp C_PLAY_PAUSE  &kp F17        &msc SCRL_UP    &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT
&trans        &kp F1        &kp F2        &kp F3        &kp F4        &mt C_NEXT C_VOLUME_DOWN    &trans    &trans  &kp C_NEXT        &kp F13        &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
                                          &none         &mkp MB1      &mkp MB2                    &trans    &trans  &mkp MB4          &mkp MB5       &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        switch_layer {
            display-name = "Switch";
            bindings = <
&kp Y             &kp U              &kp I      &kp O        &kp P     &kp BSPC                       &kp TAB      &kp Q     &kp W        &kp E          &kp R      &kp T
&kp H             &kp J              &kp K      &kp L        &kp SEMI  &kp RSHFT                      &kp LSHFT    &kp A     &kp S        &kp D          &kp F      &kp G
&kp N             &kp M              &kp COMMA  &kp DOT      &kp UP    &kp RALT                       &kp LCTRL    &kp Z     &kp X        &kp C          &kp V      &kp B
&kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SLASH  &kp LEFT     &kp DOWN  &kp RIGHT    &trans    &trans  &kp LALT     &kp LGUI  &kp GRAVE    &kp BACKSLASH  &kp MINUS  &kp PLUS
                                                &lt 4 ENTER  &none     &lt 4 ENTER  &trans    &trans  &lt 4 SPACE  &none     &lt 4 SPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        switch_special_layer {
            display-name = "Switch";
            bindings = <
&trans                &trans                 &kp SQT        &kp DQT   &kp PERCENT  &kp DELETE                    &kp ESCAPE  &kp CARET  &kp AMPERSAND  &kp ASTERISK  &trans          &trans
&kp EXCL              &kp AT                 &kp POUND      &kp DLLR  &kp COLON    &kp INSERT                    &kp LSHFT   &kp N6     &kp N7         &kp N8        &kp N9          &kp N0
&kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LESS_THAN  &kp GT    &kp PG_UP    &kp RCTRL                     &kp LCTRL   &kp N1     &kp N2         &kp N3        &kp N4          &kp N5
&kp LEFT_BRACE        &kp RIGHT_BRACE        &kp QUESTION   &kp HOME  &kp PG_DN    &kp END     &trans    &trans  &kp LALT    &kp LGUI   &kp TILDE      &kp PIPE      &kp UNDERSCORE  &kp EQUAL
                                                            &none     &none        &trans      &trans    &trans  &trans      &none      &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        keypad_layer {
            display-name = "Keypad";
            bindings = <
&trans  &trans  &trans          &trans           &trans           &trans                             &trans           &trans           &trans           &trans          &trans  &trans
&trans  &trans  &kp KP_NUMLOCK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9                    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMLOCK  &trans  &trans
&trans  &trans  &kp CAPSLOCK    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6                    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp CAPSLOCK    &trans  &trans
&trans  &trans  &kp SCROLLLOCK  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans    &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_N3        &kp SCROLLLOCK  &trans  &trans
                                &kp KP_NUMBER_0  &kp KP_DOT       &none            &trans    &trans  &none            &kp KP_NUMBER_0  &kp KP_DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
