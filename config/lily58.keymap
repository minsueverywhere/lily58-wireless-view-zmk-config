#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 4096  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 32    // default: 10

&mmv { time-to-max-speed-ms = <500>; };

/ {
    combos {
        compatible = "zmk,combos";

        M3Combo {
            bindings = <&mkp MB3>;
            key-positions = <35 33>;
            timeout-ms = <100>;
            layers = <3>;
        };

        cb_region {
            bindings = <&mcr_region>;
            key-positions = <>;
        };

        cb_export_get_set {
            bindings = <&mcr_export_get_set>;
            key-positions = <>;
        };

        cb_ifelse {
            bindings = <&mcr_ifelse>;
            key-positions = <>;
        };

        cb_match {
            bindings = <&mcr_match>;
            key-positions = <>;
        };

        cb_dictionary {
            bindings = <&mcr_dictionary>;
            key-positions = <>;
        };

        cb_print_test {
            bindings = <&mcr_print_test>;
            key-positions = <>;
        };

        cb_capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <24 35>;
        };
    };

    macros {
        mcr_region: mcr_region {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp POUND &kp R &kp E &kp G &kp I &kp O &kp N &kp RET &kp POUND &kp E &kp N &kp D &kp R &kp E &kp G &kp I &kp O &kp N &kp UP_ARROW &kp SPACE>;
            label = "MCR_REGION";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        mcr_export_get_set: mcr_export_get_set {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X) &kp AT &kp E &kp X &kp P &kp O &kp R &kp T &kp SPACE &kp V &kp A &kp R &kp SPACE &kp LC(V) &kp COLON &kp SPACE &kp LS(O) &kp B &kp J &kp E &kp C &kp T &kp SPACE &kp EQUAL &kp SPACE &kp N &kp U &kp L &kp L &kp COLON &kp RET &kp G &kp E &kp T &kp SPACE &kp EQUAL &kp SPACE &kp G &kp E &kp T &kp UNDER &kp LC(V) &kp COMMA &kp SPACE &kp S &kp E &kp T &kp SPACE &kp EQUAL &kp SPACE &kp S &kp E &kp T &kp UNDER &kp LC(V) &kp RET &kp RET &kp F &kp U &kp N &kp C &kp SPACE &kp G &kp E &kp T &kp UNDER &kp LC(V) &kp LPAR &kp RPAR &kp COLON &kp RET &kp R &kp E &kp T &kp U &kp R &kp N &kp SPACE &kp LC(V) &kp RET &kp RET &kp F &kp U &kp N &kp C &kp SPACE &kp S &kp E &kp T &kp UNDER &kp LC(V) &kp LPAR &kp V &kp A &kp L &kp U &kp E &kp COLON &kp SPACE &kp LS(O) &kp B &kp J &kp E &kp C &kp T &kp RPAR &kp COLON &kp RET &kp LC(V) &kp SPACE &kp EQUAL &kp SPACE &kp V &kp A &kp L &kp U &kp E &kp RET>;
            label = "MCR_EXPORT_GET_SET";
        };

        mcr_ifelse: mcr_ifelse {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I &kp F &kp SPACE &kp COLON &kp RET &kp P &kp A &kp S &kp S &kp RET &kp LS(TAB) &kp E &kp L &kp S &kp E &kp COLON &kp RET &kp P &kp A &kp S &kp S &kp UP_ARROW &kp UP_ARROW &kp UP_ARROW &kp LEFT_ARROW>;
            label = "MCR_IFELSE";
        };

        mcr_match: mcr_match {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp A &kp T &kp C &kp H &kp SPACE &kp COLON &kp RET &kp COLON &kp RET &kp P &kp A &kp S &kp S &kp RET &kp LS(TAB) &kp UNDER &kp COLON &kp RET &kp P &kp A &kp S &kp S &kp UP_ARROW &kp UP_ARROW &kp UP_ARROW &kp UP_ARROW &kp END &kp LEFT_ARROW>;
            label = "MCR_MATCH";
        };

        mcr_dictionary: mcr_dictionary {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp V &kp A &kp R &kp SPACE &kp UNDER &kp D &kp I &kp C &kp T &kp COLON &kp SPACE &kp LS(D) &kp I &kp C &kp ENTER &kp SPACE &kp EQUAL &kp SPACE &kp LBRC &kp RET &kp K &kp COLON &kp SPACE &kp V &kp COMMA &kp ESCAPE &kp UP_ARROW &kp LC(LEFT_ARROW)>;
            label = "MCR_DICTIONARY";
        };

        mcr_print_test: mcr_print_test {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp P &kp R &kp I &kp N &kp T &kp LPAR &kp SQT &kp T &kp E &kp S &kp T &kp SQT &kp RPAR &kp SPACE &kp POUND &kp SPACE &kp LS(T) &kp LS(E) &kp LS(S) &kp LS(T) &kp HOME &kp LC(RIGHT_ARROW) &kp LC(RIGHT_ARROW) &kp MINUS>;
            label = "MCR_PRINT_TEST";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Base";
            bindings = <
&kp ESCAPE        &kp Q         &kp W         &kp E   &kp R   &kp T                      &kp Y          &kp U   &kp I              &kp O           &kp P           &kp BSPC
&kp TAB           &kp A         &kp S         &kp D   &kp F   &kp G                      &kp H          &kp J   &kp K              &kp L           &kp SEMI        &kp ENTER
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C   &kp V   &kp B                      &kp N          &kp M   &kp COMMA          &kp DOT         &kp UP_ARROW    &kp LSHIFT
&kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &trans  &mo 2   &kp SPACE  &none    &none  &kp RIGHT_ALT  &mo 2   &kp RIGHT_CONTROL  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
                                              &mo 3   &trans  &mo 1      &none    &none  &mo 1          &trans  &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        special_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Special";
            bindings = <
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH   &kp DOLLAR      &kp PERCENT                          &kp CARET     &kp AMPERSAND   &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&kp GRAVE  &kp N1           &kp N2       &kp N3     &kp N4          &kp N5                               &kp N6        &kp N7          &kp N8           &kp N9                &kp N0                 &kp BSLH
&kp SQT    &kp EQUAL        &kp PLUS     &kp MINUS  &kp UNDERSCORE  &kp DOUBLE_QUOTES                    &kp QUESTION  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SLASH
&trans     &trans           &trans       &trans     &trans          &trans             &trans    &trans  &trans        &trans          &trans           &trans                &trans                 &trans
                                         &trans     &trans          &trans             &trans    &trans  &trans        &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        function_layer {
            display-name = "Function";
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &bt BT_SEL 0                     &kp INSERT                  &kp F13  &kp F14  &kp F15  &kp F16  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &bt BT_SEL 1                     &mt C_PREVIOUS C_VOLUME_UP  &kp F17  &kp F18  &kp F19  &kp F20  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &bt BT_SEL 2                     &mt C_NEXT C_VOLUME_DOWN    &kp F21  &kp F22  &kp F23  &kp F24  &trans
&trans  &trans  &trans   &trans   &trans   &bt BT_DISC 2  &trans    &trans  &mt C_MUTE C_PLAY_PAUSE     &trans   &trans   &trans   &trans   &trans
                         &trans   &trans   &trans         &trans    &trans  &trans                      &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        numpad_layer {
            display-name = "Numpad";
            bindings = <
&kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans  &trans  &trans                    &trans  &trans  &trans  &mkp MB4        &msc SCRL_UP    &mkp MB5
&kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans  &trans  &trans                    &trans  &trans  &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT
&kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans  &trans  &trans                    &trans  &trans  &trans  &mkp MB1        &mmv MOVE_UP    &mkp MB2
&kp KP_N0        &kp KP_DOT       &trans           &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
                                                   &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
