#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 4096  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 32    // default: 10

&mmv { time-to-max-speed-ms = <500>; };

/ {
    combos {
        compatible = "zmk,combos";

        cb_capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <24 35>;
        };

        cb_numpad {
            bindings = <&mo 5>;
            key-positions = <50 39>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Base";
            bindings = <
&kp ESCAPE        &kp Q         &kp W         &kp E      &kp R          &kp T                      &kp Y      &kp U      &kp I             &kp O              &kp P      &kp BSPC
&kp TAB           &kp A         &kp S         &kp D      &kp F          &kp G                      &kp H      &kp J      &kp K             &kp L              &kp SEMI   &kp APOSTROPHE
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C      &kp V          &kp B                      &kp N      &kp M      &kp COMMA         &kp DOT            &kp SLASH  &kp RIGHT_SHIFT
&kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp GRAVE  &kp BACKSLASH  &kp SPACE  &none    &none  &kp ENTER  &kp MINUS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp EQUAL  &kp RIGHT_ALT
                                              &mo 3      &mo 2          &mo 1      &none    &none  &mo 1      &mo 2      &mo 4
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        special_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Special";
            bindings = <
&kp ESCAPE   &trans    &trans      &trans     &trans    &trans                         &trans           &trans          &trans                &trans                 &trans        &kp DELETE
&kp LS(TAB)  &kp N1    &kp N2      &kp N3     &kp N4    &kp N5                         &kp AMPERSAND    &kp ASTERISK    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp COLON     &kp DOUBLE_QUOTES
&trans       &kp N6    &kp N7      &kp N8     &kp N9    &kp N0                         &kp EXCLAMATION  &kp AT_SIGN     &kp LESS_THAN         &kp GREATER_THAN       &kp QUESTION  &trans
&trans       &kp HASH  &kp DOLLAR  &kp TILDE  &kp PIPE  &kp PERCENT  &trans    &trans  &kp CARET        &kp UNDERSCORE  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PLUS      &trans
                                   &trans     &trans    &none        &trans    &trans  &none            &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        function_layer {
            display-name = "Function";
            bindings = <
&kp ESCAPE  &kp F12  &trans  &trans  &trans  &trans                    &kp INSERT                  &trans   &trans   &trans   &kp F24                  &kp DELETE
&trans      &kp F11  &kp F7  &kp F8  &kp F9  &trans                    &trans                      &kp F19  &kp F20  &kp F21  &kp F23                  &trans
&trans      &kp F10  &kp F4  &kp F5  &kp F6  &trans                    &mt C_PREVIOUS C_VOLUME_UP  &kp F16  &kp F17  &kp F18  &kp F22                  &trans
&trans      &trans   &kp F1  &kp F2  &kp F3  &trans  &trans    &trans  &mt C_NEXT C_VOLUME_DOWN    &kp F13  &kp F14  &kp F15  &mt C_MUTE C_PLAY_PAUSE  &trans
                             &trans  &none   &trans  &trans    &trans  &trans                      &none    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&kp ESCAPE      &trans          &trans           &trans          &trans  &trans                          &bt BT_CLR     &trans  &trans  &trans    &trans    &kp DELETE
&trans          &trans          &trans           &trans          &trans  &bt BT_SEL 0                    &bt BT_DISC 0  &trans  &trans  &trans    &trans    &trans
&msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &msc SCRL_UP    &trans  &bt BT_SEL 1                    &bt BT_DISC 1  &trans  &trans  &mkp MB4  &trans    &mkp MB5
&mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN  &trans  &bt BT_SEL 2  &trans    &trans  &bt BT_DISC 2  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2
                                                 &none           &trans  &trans        &trans    &trans  &trans         &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        arrow_layer {
            display-name = "Arrow";
            bindings = <
&kp ESCAPE  &trans  &trans  &trans  &trans  &trans                          &bt BT_CLR     &trans  &trans         &trans          &trans          &kp DELETE
&trans      &trans  &trans  &trans  &trans  &bt BT_SEL 0                    &bt BT_DISC 0  &trans  &trans         &trans          &trans          &trans
&trans      &trans  &trans  &trans  &trans  &bt BT_SEL 1                    &bt BT_DISC 1  &trans  &kp PAGE_UP    &kp HOME        &kp UP_ARROW    &kp END
&trans      &trans  &trans  &trans  &trans  &bt BT_SEL 2  &trans    &trans  &bt BT_DISC 2  &trans  &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
                            &trans  &trans  &trans        &trans    &trans  &trans         &trans  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        numpad_layer {
            display-name = "Numpad";
            bindings = <
&kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMLOCK  &kp SCROLLLOCK  &kp INSERT                    &trans  &trans  &trans  &trans  &trans  &trans
&kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans          &trans          &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans          &trans          &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&kp KP_N0        &kp KP_DOT       &kp KP_ENTER     &trans          &trans          &trans      &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                   &trans          &trans          &trans      &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
