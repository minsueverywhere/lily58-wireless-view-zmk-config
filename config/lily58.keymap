#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

&mmv { time-to-max-speed-ms = <100>; };

/ {
    combos {
        compatible = "zmk,combos";

        LShiftCombo {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <26 37>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        LControlCombo {
            bindings = <&kp LCTRL>;
            key-positions = <27 37>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        LAltCombo {
            bindings = <&kp LEFT_ALT>;
            key-positions = <28 37>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        LCtrlLShiftCombo {
            bindings = <&kp LC(LEFT_SHIFT)>;
            key-positions = <26 27 37>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        LCtrlLAltCombo {
            bindings = <&kp LC(LEFT_ALT)>;
            key-positions = <27 28 37>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        LCtrlLShiftLAltCombo {
            bindings = <&kp LC(LA(LEFT_SHIFT))>;
            key-positions = <26 27 28 37>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        RShiftCombo {
            bindings = <&kp RSHIFT>;
            key-positions = <33 48>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        RCtrlCombo {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <32 48>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        RLAltCombo {
            bindings = <&kp LEFT_ALT>;
            key-positions = <31 48>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        RCtrlRShiftCombo {
            bindings = <&kp LC(RIGHT_SHIFT)>;
            key-positions = <33 32 48>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        RCtrlRAltCombo {
            bindings = <&kp LC(LEFT_ALT)>;
            key-positions = <32 31 48>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        RCtrlRShiftRAltCombo {
            bindings = <&kp LC(LA(RIGHT_SHIFT))>;
            key-positions = <31 32 33 48>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        LGuiCombo {
            bindings = <&kp LEFT_GUI>;
            key-positions = <29 37>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        RGuiCombo {
            bindings = <&kp RIGHT_GUI>;
            key-positions = <30 48>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        LShiftLAltCombo {
            bindings = <&kp LA(LEFT_SHIFT)>;
            key-positions = <26 28 37>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <100>;
        };

        RShiftLAltCombo {
            bindings = <&kp LA(RIGHT_SHIFT)>;
            key-positions = <33 31 48>;
            slow-release;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        LShiftLGuiCombo {
            bindings = <&kp LS(LEFT_GUI)>;
            key-positions = <29 37 26>;
            require-prior-idle-ms = <50>;
            slow-release;
            timeout-ms = <100>;
        };

        LCtrlLGuiCombo {
            bindings = <&kp LC(LEFT_GUI)>;
            key-positions = <29 37 27>;
            require-prior-idle-ms = <50>;
            slow-release;
            timeout-ms = <100>;
        };

        LAltLGuiCombo {
            bindings = <&kp LA(LEFT_GUI)>;
            key-positions = <29 28 37>;
            require-prior-idle-ms = <50>;
            slow-release;
            timeout-ms = <100>;
        };

        RShiftRGuiCombo {
            bindings = <&kp LS(RIGHT_GUI)>;
            key-positions = <30 48 33>;
            slow-release;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        LCtrlRGuiCombo {
            bindings = <&kp LC(RIGHT_GUI)>;
            key-positions = <30 48 32>;
            slow-release;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        LAltRGuiCombo {
            bindings = <&kp LA(RIGHT_GUI)>;
            key-positions = <30 31 48>;
            slow-release;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        UpperPCombo {
            bindings = <&kp LS(P)>;
            key-positions = <>;
            require-prior-idle-ms = <50>;
            timeout-ms = <50>;
            slow-release;
        };

        UpperOCombo {
            bindings = <&kp LS(O)>;
            key-positions = <>;
            slow-release;
            require-prior-idle-ms = <50>;
        };

        UpperQCombo {
            bindings = <&kp RS(Q)>;
            key-positions = <>;
            require-prior-idle-ms = <50>;
            timeout-ms = <50>;
            slow-release;
        };

        UpperWCombo {
            bindings = <&kp RS(W)>;
            key-positions = <>;
            slow-release;
            timeout-ms = <50>;
            require-prior-idle-ms = <50>;
        };

        UpperECombo {
            bindings = <&kp RS(E)>;
            key-positions = <>;
            timeout-ms = <50>;
            require-prior-idle-ms = <50>;
            slow-release;
        };

        UpperRCombo {
            bindings = <&kp RS(R)>;
            key-positions = <>;
            timeout-ms = <50>;
            require-prior-idle-ms = <50>;
            slow-release;
        };

        UpperTCombo {
            bindings = <&kp RS(T)>;
            key-positions = <>;
            timeout-ms = <50>;
            require-prior-idle-ms = <50>;
            slow-release;
        };

        LRAltCombo {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <50 51>;
            timeout-ms = <50>;
            require-prior-idle-ms = <50>;
            slow-release;
        };

        RAltCombo {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <56 57>;
            timeout-ms = <50>;
            require-prior-idle-ms = <50>;
            slow-release;
        };
    };

    behaviors {
        esc_tilde: esc_tilde {
            compatible = "zmk,behavior-mod-morph";
            label = "ESC_TILDE";
            bindings = <&kp ESCAPE>, <&kp TILDE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Base";
            bindings = <
&esc_tilde      &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                       &kp N6       &kp N7  &kp N8     &kp N9   &kp N0    &kp CAPSLOCK
&kp TAB         &kp Q   &kp W   &kp E   &kp R   &kp T                        &kp Y        &kp U   &kp I      &kp O    &kp P     &kp BACKSPACE
&kp LCTRL       &kp A   &kp S   &kp D   &kp F   &kp G                        &kp H        &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z   &kp X   &kp C   &kp V   &kp B        &none    &none  &kp N        &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHIFT
                                &mo 3   &mo 2   &lt 1 SPACE  &none    &none  &lt 1 ENTER  &mo 2   &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fn_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "FN";
            bindings = <
&trans  &trans  &trans  &trans                   &trans                 &trans                     &trans          &trans          &trans          &trans           &trans    &trans
&trans  &trans  &trans  &trans                   &trans                 &trans                     &trans          &trans          &trans          &trans           &trans    &trans
&kp F1  &kp F2  &kp F3  &kp F4                   &kp F5                 &kp F6                     &msc SCRL_UP    &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &mkp MB3  &trans
&kp F7  &kp F8  &kp F9  &kp F10                  &kp F11                &kp F12  &trans    &trans  &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB1  &mkp MB2
                        &mt C_MUTE C_PLAY_PAUSE  &mt C_PREVIOUS C_NEXT  &trans   &trans    &trans  &trans          &mkp MB4        &mkp MB5
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        special_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Special";
            bindings = <
&trans     &trans           &trans       &trans          &trans      &trans                               &trans             &trans          &trans           &trans                &trans                 &trans
&trans     &kp MINUS        &kp EQUAL    &kp UNDERSCORE  &kp PLUS    &kp RIGHT_CONTROL                    &kp RIGHT_CONTROL  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH        &kp DOLLAR  &kp PERCENT                          &kp CARET          &kp AMPERSAND   &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&kp GRAVE  &kp N1           &kp N2       &kp N3          &kp N4      &kp N5             &trans    &trans  &kp N6             &kp N7          &kp N8           &kp N9                &kp N0                 &kp BACKSLASH
                                         &kp RIGHT_ALT   &trans      &trans             &trans    &trans  &trans             &trans          &kp RIGHT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        mod_layer {
            display-name = "Mod";
            bindings = <
&bt BT_CLR    &kp KP_NUMLOCK  &kp KP_PLUS  &kp KP_MINUS     &kp KP_MULTIPLY  &kp KP_SLASH                       &kp PRINTSCREEN  &kp SCROLLLOCK   &kp PAUSE_BREAK  &kp PAGE_UP    &kp HOME  &kp INSERT
&bt BT_SEL 0  &trans          &trans       &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9                    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PAGE_DOWN  &kp END   &kp DELETE
&bt BT_SEL 1  &trans          &trans       &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6                    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp SPACE      &kp UP    &kp TAB
&bt BT_SEL 2  &trans          &trans       &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans    &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp LEFT       &kp DOWN  &kp RIGHT
                                           &trans           &kp KP_NUMBER_0  &kp KP_DOT       &trans    &trans  &kp KP_DOT       &kp KP_NUMBER_0  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lefthanded_layer {
            display-name = "Gui";
            bindings = <
&kp N6  &kp N7  &kp N8     &kp N9     &kp N0    &kp CAPSLOCK                       &trans  &trans  &trans  &trans  &trans  &trans
&kp Y   &kp U   &kp I      &kp O      &kp P     &kp BSPC                           &trans  &trans  &trans  &trans  &trans  &trans
&kp H   &kp J   &kp K      &kp L      &kp SEMI  &kp SQT                            &trans  &trans  &trans  &trans  &trans  &trans
&kp N   &kp M   &kp COMMA  &kp DOT    &kp FSLH  &kp RIGHT_SHIFT  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                           &kp ENTER  &trans    &kp RIGHT_ALT    &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
