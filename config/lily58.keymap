#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 2400  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30    // default: 10

&mmv {
    time-to-max-speed-ms = <200>;
    acceleration-exponent = <1>;
};

&lt { flavor = "balanced"; };

/ {
    combos {
        compatible = "zmk,combos";

        M3Combo {
            bindings = <&mkp MB3>;
            key-positions = <5 6>;
            timeout-ms = <100>;
        };

        cb_1 {
            bindings = <&kp NUMBER_1>;
            key-positions = <52 25>;
            timeout-ms = <100>;
        };

        cb_2 {
            bindings = <&kp NUMBER_2>;
            key-positions = <52 26>;
            timeout-ms = <100>;
        };

        cb_3 {
            bindings = <&kp NUMBER_3>;
            key-positions = <52 27>;
            timeout-ms = <100>;
        };

        cb_4 {
            bindings = <&kp NUMBER_4>;
            key-positions = <52 28>;
            timeout-ms = <100>;
        };

        cb_5 {
            bindings = <&kp NUMBER_5>;
            key-positions = <52 29>;
            timeout-ms = <100>;
        };

        cb_6 {
            bindings = <&kp NUMBER_6>;
            key-positions = <55 30>;
            timeout-ms = <100>;
        };

        cb_7 {
            bindings = <&kp NUMBER_7>;
            key-positions = <55 31>;
            timeout-ms = <100>;
        };

        cb_8 {
            bindings = <&kp NUMBER_8>;
            key-positions = <55 32>;
            timeout-ms = <100>;
        };

        cb_9 {
            bindings = <&kp NUMBER_9>;
            key-positions = <55 33>;
            timeout-ms = <100>;
        };

        cb_0 {
            bindings = <&kp NUMBER_0>;
            key-positions = <55 34>;
            timeout-ms = <100>;
        };

        cb_grave {
            bindings = <&kp GRAVE>;
            key-positions = <52 38>;
            timeout-ms = <100>;
        };

        cb_dash {
            bindings = <&kp MINUS>;
            key-positions = <52 39>;
            timeout-ms = <100>;
        };

        cb_eqaul {
            bindings = <&kp EQUAL>;
            key-positions = <52 40>;
            timeout-ms = <100>;
        };

        cb_lb {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <55 45>;
            timeout-ms = <100>;
        };

        cb_rb {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <55 46>;
            timeout-ms = <100>;
        };

        cb_bs {
            bindings = <&kp BACKSLASH>;
            key-positions = <55 47>;
            timeout-ms = <100>;
        };

        cb_s1 {
            bindings = <&kp EXCLAMATION>;
            key-positions = <52 25 24>;
            timeout-ms = <100>;
        };

        cb_s2 {
            bindings = <&kp AT_SIGN>;
            key-positions = <52 26 24>;
            timeout-ms = <100>;
        };

        cb_s3 {
            bindings = <&kp HASH>;
            key-positions = <52 27 24>;
            timeout-ms = <100>;
        };

        cb_s4 {
            bindings = <&kp DOLLAR>;
            key-positions = <52 28 24>;
            timeout-ms = <100>;
        };

        cb_s5 {
            bindings = <&kp PERCENT>;
            key-positions = <52 29 24>;
            timeout-ms = <100>;
        };

        cb_s6 {
            bindings = <&kp CARET>;
            key-positions = <55 30 35>;
            timeout-ms = <100>;
        };

        cb_s7 {
            bindings = <&kp AMPERSAND>;
            key-positions = <55 31 35>;
            timeout-ms = <100>;
        };

        cb_s8 {
            bindings = <&kp ASTERISK>;
            key-positions = <55 32 35>;
            timeout-ms = <100>;
        };

        cb_s9 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <55 33 35>;
            timeout-ms = <100>;
        };

        cb_s0 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <55 34 35>;
            timeout-ms = <100>;
        };

        cb_tilde {
            bindings = <&kp TILDE>;
            key-positions = <52 38 24>;
            timeout-ms = <100>;
        };

        cb_us {
            bindings = <&kp UNDERSCORE>;
            key-positions = <52 39 24>;
            timeout-ms = <100>;
        };

        cb_plus {
            bindings = <&kp PLUS>;
            key-positions = <52 40 24>;
            timeout-ms = <100>;
        };

        cb_lbc {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <55 45 35>;
            timeout-ms = <100>;
        };

        cb_rbc {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <55 46 35>;
            timeout-ms = <100>;
        };

        cb_pipe {
            bindings = <&kp PIPE>;
            key-positions = <55 47 35>;
            timeout-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Base";
            bindings = <
&kp ESCAPE        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp MB2                     &mkp MB1     &kp LEFT         &kp DOWN             &kp UP   &kp RIGHT  &kp DELETE
&kp TAB           &kp Q           &kp W           &kp E         &kp R            &kp T                        &kp Y        &kp U            &kp I                &kp O    &kp P      &kp BACKSPACE
&kp LEFT_SHIFT    &kp A           &kp S           &kp D         &kp F            &kp G                        &kp H        &kp J            &kp K                &kp L    &kp SEMI   &kp RIGHT_SHIFT
&kp LEFT_CONTROL  &kp Z           &kp X           &kp C         &kp V            &kp B        &none    &none  &kp N        &kp M            &kp COMMA            &kp DOT  &kp FSLH   &kp SQT
                                                  &kp LEFT_ALT  &lt 2 LEFT_GUI   &lt 1 SPACE  &none    &none  &lt 1 ENTER  &lt 2 RIGHT_ALT  &lt 3 RIGHT_CONTROL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        special_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Special";
            bindings = <
&mkp MB4  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &mkp MB5                    &kp LS(LC(TAB))  &kp HOME  &kp PG_UP  &kp PG_DN  &kp END  &kp LC(TAB)
&trans    &trans          &trans          &trans        &trans           &trans                      &trans           &trans    &trans     &trans     &trans   &trans
&trans    &kp N1          &kp N2          &kp N3        &kp N4           &kp N5                      &kp N6           &kp N7    &kp N8     &kp N9     &kp N0   &trans
&trans    &trans          &kp GRAVE       &kp MINUS     &kp EQUAL        &trans    &trans    &trans  &trans           &kp LBKT  &kp RBKT   &kp BSLH   &trans   &trans
                                          &trans        &trans           &trans    &trans    &trans  &trans           &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fn_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "FN";
            bindings = <
&trans         &trans  &trans   &trans   &trans   &trans                                        &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_NXT     &kp F1  &kp F2   &kp F3   &kp F4   &mt C_PREVIOUS C_VOLUME_UP                    &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_PRV     &kp F5  &kp F6   &kp F7   &kp F8   &mt C_NEXT C_VOLUME_DOWN                      &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_DISC 2  &kp F9  &kp F10  &kp F11  &kp F12  &mt C_MUTE C_PLAY_PAUSE     &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                &trans   &trans   &trans                      &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        mod_layer {
            display-name = "Mod";
            bindings = <
&trans  &trans           &trans         &trans           &trans           &trans                             &trans           &trans           &trans           &trans           &trans         &trans
&trans  &kp KP_NUMLOCK   &kp CAPSLOCK   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9                    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMLOCK   &kp CAPSLOCK   &trans
&trans  &kp KP_PLUS      &kp KP_MINUS   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6                    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS      &kp KP_MINUS   &trans
&trans  &kp KP_MULTIPLY  &kp KP_DIVIDE  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans    &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MULTIPLY  &kp KP_DIVIDE  &trans
                                        &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_ENTER     &trans    &trans  &kp KP_DOT       &kp KP_NUMBER_0  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
