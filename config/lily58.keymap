#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 4096  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 32    // default: 10

&mmv { time-to-max-speed-ms = <500>; };

/ {
    combos {
        compatible = "zmk,combos";

        M3Combo {
            bindings = <&mkp MB3>;
            key-positions = <35 33>;
            timeout-ms = <100>;
            layers = <4>;
        };

        cb_capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <12 23>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Base";
            bindings = <
&kp TAB           &kp Q         &kp W  &kp E              &kp R  &kp T                      &kp Y          &kp U  &kp I      &kp O           &kp P           &kp BSPC
&kp LEFT_SHIFT    &kp A         &kp S  &kp D              &kp F  &kp G                      &kp H          &kp J  &kp K      &kp L           &kp SEMI        &kp RIGHT_SHIFT
&kp LEFT_GUI      &kp Z         &kp X  &kp C              &kp V  &kp B                      &kp N          &kp M  &kp COMMA  &kp DOT         &kp UP_ARROW    &kp ENTER
&kp LEFT_CONTROL  &kp LEFT_ALT  &mo 4  &kp RIGHT_CONTROL  &mo 2  &kp SPACE  &none    &none  &kp RIGHT_ALT  &mo 2  &kp SLASH  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
                                       &mo 3              &mo 1  &trans     &none    &none  &trans         &mo 1  &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        special_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Special";
            bindings = <
&kp ESCAPE  &kp EQUAL        &kp PLUS     &kp MINUS  &kp UNDERSCORE  &kp SINGLE_QUOTE                    &kp DOUBLE_QUOTES  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp DELETE
&kp TILDE   &kp EXCLAMATION  &kp AT_SIGN  &kp HASH   &kp DOLLAR      &kp PERCENT                         &kp CARET          &kp CARET       &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&kp GRAVE   &kp N1           &kp N2       &kp N3     &kp N4          &kp N5                              &kp N6             &kp N7          &kp N8           &kp N9                &kp N0                 &kp BACKSLASH
&trans      &trans           &trans       &trans     &trans          &trans            &trans    &trans  &trans             &trans          &trans           &trans                &trans                 &trans
                                          &trans     &trans          &trans            &trans    &trans  &trans             &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        function_layer {
            display-name = "Function";
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &bt BT_SEL 0                    &kp INSERT                  &kp F13  &kp F14  &kp F15  &kp F16  &bt BT_DISC 0
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &bt BT_SEL 1                    &mt C_PREVIOUS C_VOLUME_UP  &kp F17  &kp F18  &kp F19  &kp F20  &bt BT_DISC 1
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &bt BT_SEL 2                    &mt C_NEXT C_VOLUME_DOWN    &kp F21  &kp F22  &kp F23  &kp F24  &bt BT_DISC 2
&trans  &trans  &trans   &trans   &trans   &trans        &trans    &trans  &mt C_MUTE C_PLAY_PAUSE     &trans   &trans   &trans   &trans   &bt BT_CLR
                         &trans   &trans   &trans        &trans    &trans  &trans                      &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        cursor_layer {
            display-name = "Cursor";
            bindings = <
&trans          &trans          &trans           &trans  &trans  &trans                    &trans  &trans  &trans  &mkp MB4        &msc SCRL_UP    &mkp MB5
&trans          &trans          &trans           &trans  &trans  &trans                    &trans  &trans  &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT
&trans          &mmv MOVE_UP    &trans           &trans  &trans  &trans                    &trans  &trans  &trans  &mkp MB1        &kp PAGE_UP     &mkp MB2
&mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &kp HOME        &kp PAGE_DOWN   &kp END
                                                 &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        numpad_layer {
            display-name = "Numpad";
            bindings = <
&kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans          &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans          &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans          &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&kp KP_N0        &kp KP_DOT       &trans           &trans          &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                   &kp KP_NUMLOCK  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
