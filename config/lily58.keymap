#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

/ {
    combos {
        compatible = "zmk,combos";

        LShiftCombo {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <25 26>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <50>;
        };

        LControlCombo {
            bindings = <&kp LCTRL>;
            key-positions = <26 27>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <50>;
        };

        LAltCombo {
            bindings = <&kp LEFT_ALT>;
            key-positions = <27 28>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <50>;
        };

        LCtrlLShiftCombo {
            bindings = <&kp LC(LEFT_SHIFT)>;
            key-positions = <25 26 27>;
            slow-release;
            require-prior-idle-ms = <50>;
        };

        LCtrlLAltCombo {
            bindings = <&kp LC(LEFT_ALT)>;
            key-positions = <26 27 28>;
            slow-release;
            require-prior-idle-ms = <50>;
        };

        LCtrlLShiftLAltCombo {
            bindings = <&kp LC(LA(LEFT_SHIFT))>;
            key-positions = <25 26 27 28>;
            slow-release;
            require-prior-idle-ms = <50>;
        };

        RShiftCombo {
            bindings = <&kp RSHIFT>;
            key-positions = <34 33>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <50>;
        };

        RCtrlCombo {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <33 32>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <50>;
        };

        RAltCombo {
            bindings = <&kp LEFT_ALT>;
            key-positions = <31 32>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <50>;
        };

        RCtrlRShiftCombo {
            bindings = <&kp LC(RIGHT_SHIFT)>;
            key-positions = <34 33 32>;
            slow-release;
            require-prior-idle-ms = <50>;
        };

        RCtrlRAltCombo {
            bindings = <&kp LC(LEFT_ALT)>;
            key-positions = <32 31 33>;
            slow-release;
            require-prior-idle-ms = <50>;
        };

        RCtrlRShiftRAltCombo {
            bindings = <&kp LC(LA(RIGHT_SHIFT))>;
            key-positions = <31 32 33 34>;
            slow-release;
            require-prior-idle-ms = <50>;
        };

        LGuiCombo {
            bindings = <&kp LEFT_GUI>;
            key-positions = <28 29>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <50>;
        };

        RGuiCombo {
            bindings = <&kp RIGHT_GUI>;
            key-positions = <31 30>;
            slow-release;
            require-prior-idle-ms = <50>;
            timeout-ms = <50>;
        };

        LShiftLAltCombo {
            bindings = <&kp LA(LEFT_SHIFT)>;
            key-positions = <25 26 28>;
            slow-release;
            require-prior-idle-ms = <50>;
        };

        RShiftLAltCombo {
            bindings = <&kp LA(RIGHT_SHIFT)>;
            key-positions = <34 33 31>;
        };

        LShiftLGuiCombo {
            bindings = <&kp LS(LEFT_GUI)>;
            key-positions = <29 28 25>;
            require-prior-idle-ms = <50>;
            slow-release;
        };

        LCtrlLGuiCombo {
            bindings = <&kp LC(LEFT_GUI)>;
            key-positions = <29 28 26>;
            require-prior-idle-ms = <50>;
            slow-release;
        };

        LAltLGuiCombo {
            bindings = <&kp LA(LEFT_GUI)>;
            key-positions = <29 28 27>;
            require-prior-idle-ms = <50>;
            slow-release;
        };

        RShiftRGuiCombo {
            bindings = <&kp LS(RIGHT_GUI)>;
            key-positions = <30 31 34>;
        };

        LCtrlRGuiCombo {
            bindings = <&kp LC(RIGHT_GUI)>;
            key-positions = <30 31 33>;
        };

        LAltRGuiCombo {
            bindings = <&kp LA(RIGHT_GUI)>;
            key-positions = <30 31 32>;
        };
    };

    behaviors {
        esc_tilde: esc_tilde {
            compatible = "zmk,behavior-mod-morph";
            label = "ESC_TILDE";
            bindings = <&kp ESCAPE>, <&kp TILDE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mouse_movement: mouse_movement {
            compatible = "zmk,behavior-input-two-axis";
            label = "MOUSE_MOVEMENT";
            #binding-cells = <1>;
            acceleration-exponent = <0>;
            time-to-max-speed-ms = <0>;
            x-input-code = <0>;
            y-input-code = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&esc_tilde          &kp N1  &kp N2  &kp N3        &kp N4          &kp N5                       &kp N6       &kp N7           &kp N8             &kp N9   &kp N0    &kp GRAVE
&kp TAB             &kp Q   &kp W   &kp E         &kp R           &kp T                        &kp Y        &kp U            &kp I              &kp O    &kp P     &kp BACKSLASH
&mt LCTRL CAPSLOCK  &kp A   &kp S   &kp D         &kp F           &kp G                        &kp H        &kp J            &kp K              &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT      &kp Z   &kp X   &kp C         &kp V           &kp B        &none    &none  &kp N        &kp M            &kp COMMA          &kp DOT  &kp FSLH  &kp BACKSPACE
                                    &kp LEFT_ALT  &lt 2 LEFT_GUI  &lt 1 SPACE  &none    &none  &lt 1 ENTER  &lt 2 RIGHT_ALT  &kp RIGHT_CONTROL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        space_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Space";
            bindings = <
&trans  &trans  &trans   &trans            &trans      &trans                           &mkp MB4    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &mkp MB5
&trans  &kp F1  &kp F2   &kp F3            &kp F4      &trans                           &mkp LCLK   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp RCLK
&trans  &kp F5  &kp F6   &kp F7            &kp F8      &trans                           &mkp MCLK   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &mouse_movement MOVE_DOWN
&trans  &kp F9  &kp F10  &kp F11           &kp F12     &kp RIGHT_ALT  &trans    &trans  &kp INSERT  &kp HOME        &kp PG_DN       &kp PG_UP     &kp END          &kp DELETE
                         &kp C_PLAY_PAUSE  &kp C_MUTE  &trans         &trans    &trans  &trans      &kp C_PREVIOUS  &kp C_NEXT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        enter_layer {
            display-name = "Enter";
            bindings = <
&bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1          &bt BT_SEL 2           &bt BT_SEL 3     &bt BT_SEL 4                         &kp KP_NUMLOCK   &trans           &trans           &trans                 &trans           &trans
&kp MINUS         &kp N1          &kp N2                &kp N3                 &kp N4           &kp N5                               &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS              &kp EQUAL        &trans
&kp EQUAL         &kp N6          &kp N7                &kp N8                 &kp N9           &kp N0                               &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp LEFT_PARENTHESIS   &kp LEFT_BRACE   &kp LEFT_BRACKET
&kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &trans    &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET
                                                        &trans                 &trans           &trans             &trans    &trans  &kp KP_NUMBER_0  &trans           &kp KP_DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
