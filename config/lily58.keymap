#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 4096  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 32    // default: 10

&mmv { time-to-max-speed-ms = <500>; };

/ {
    combos {
        compatible = "zmk,combos";

        cb_capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <24 35>;
        };

        cb_numpad {
            bindings = <&mo 3>;
            key-positions = <50 39>;
            slow-release;
        };

        cb_m3 {
            bindings = <&mkp MB3>;
            key-positions = <55 57>;
            layers = <1>;
        };

        cb_lgui {
            bindings = <&kp LEFT_GUI>;
            key-positions = <50 51>;
        };

        cb_rctrl {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <36 49>;
        };
    };

    behaviors {
        sticky_shift: sticky_shift {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_SHIFT";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <300>;
            quick-release;
        };

        shift_hold_tap: shift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "SHIFT_HOLD_TAP";
            bindings = <&kp>, <&sticky_shift>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
        };

        my_shift: my_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "MY_SHIFT";
            #binding-cells = <0>;
            bindings = <&shift_hold_tap LEFT_SHIFT LEFT_SHIFT>, <&caps_word>;

            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Base";
            bindings = <
&kp ESCAPE        &kp N1  &kp N2  &kp N3        &kp N4  &kp N5                     &kp N6     &kp N7  &kp N8     &kp N9   &kp N0    &kp DELETE
&kp TAB           &kp Q   &kp W   &kp E         &kp R   &kp T                      &kp Y      &kp U   &kp I      &kp O    &kp P     &kp BACKSPACE
&my_shift         &kp A   &kp S   &kp D         &kp F   &kp G                      &kp H      &kp J   &kp K      &kp L    &kp SEMI  &my_shift
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C         &kp V   &kp B      &none    &none  &kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_ALT
                                  &kp LEFT_ALT  &mo 1   &kp SPACE  &none    &none  &kp ENTER  &mo 1   &mo 2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        special_layer {
            // ------------------------------------------------------------------------------------------------------------

            display-name = "Special";
            bindings = <
&trans     &kp EXCLAMATION  &kp AT_SIGN     &kp HASH        &kp DOLLAR       &kp PERCENT                        &kp CARET         &kp AMPERSAND      &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&kp GRAVE  &kp TILDE        &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &msc SCRL_UP                       &kp PG_UP         &kp HOME           &kp UP         &kp END               &kp PIPE               &kp BACKSLASH
&trans     &kp EQUAL        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN                     &kp PG_DN         &kp LEFT           &kp DOWN       &kp RIGHT             &kp COLON              &kp APOSTROPHE
&trans     &kp PLUS         &kp UNDERSCORE  &kp MINUS       &kp LEFT_BRACE   &kp RIGHT_BRACE  &trans    &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LESS_THAN  &kp GREATER_THAN      &kp QUESTION           &kp DOUBLE_QUOTES
                                            &mkp MB4        &none            &mkp MB5         &trans    &trans  &mkp MB1          &none              &mkp MB2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        function_layer {
            display-name = "Function";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans   &trans   &trans                               &bt BT_DISC 0     &bt BT_DISC 1  &bt BT_DISC 2  &trans   &trans   &bt BT_CLR
&trans        &kp F9        &kp F10       &kp F11  &kp F12  &kp C_VOLUME_UP                      &kp C_PREVIOUS    &kp F21        &kp F22        &kp F23  &kp F24  &trans
&trans        &kp F5        &kp F6        &kp F7   &kp F8   &kp C_MUTE                           &kp C_PLAY_PAUSE  &kp F17        &kp F18        &kp F19  &kp F20  &trans
&trans        &kp F1        &kp F2        &kp F3   &kp F4   &kp C_VOLUME_DOWN  &trans    &trans  &kp C_NEXT        &kp F13        &kp F14        &kp F15  &kp F16  &trans
                                          &trans   &trans   &trans             &trans    &trans  &trans            &trans         &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        keypad_layer {
            display-name = "Keypad";
            bindings = <
&kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMLOCK  &kp SCROLLLOCK  &kp INSERT                    &trans  &trans  &trans  &trans  &trans  &trans
&kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans          &trans          &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans          &trans          &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&kp KP_N0        &kp KP_DOT       &kp KP_ENTER     &trans          &trans          &trans      &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                   &trans          &trans          &trans      &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
